<?xml version="1.0" encoding="utf-8"?>
<!-- Phone build (./build.sh phone): same code as the TV and car apps (app/), with the phone home
     screen (phone.html): home pages with apps, folders and widgets you arrange by dragging, a dock,
     the App Library, azkar, prayer times for where you are and silent prayer banners. Made for
     foldables too: the grid follows the screen as you fold, unfold or turn it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mk.phonelauncher"
    android:versionCode="8"
    android:versionName="1.6.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the launcher see every installed app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- ...and every app widget (Add App Widget). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:label="MK Launcher"
        android:icon="@drawable/icon"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <meta-data android:name="flavor" android:value="phone" />

        <activity
            android:name="com.mk.homedash.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name="com.mk.homedash.PrayerAlert" android:exported="false" />
    </application>
</manifest>
