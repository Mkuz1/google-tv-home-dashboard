<?xml version="1.0" encoding="utf-8"?>
<!-- Car head unit build (./build.sh car): same code as the TV app (app/), with the touch-first
     car home screen (car.html: time, Wi-Fi, Settings, sidebar apps, azkar, prayer times
     for where the car is, silent prayer banners, split screen, app drawer). The optional split-screen
     helper (an accessibility service) is a separate APK, helper/AndroidManifest.xml.
     No screensaver in the car. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mk.carlauncher"
    android:versionCode="16"
    android:versionName="2.4.4">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Prayer times follow the car (GPS); silent prayer banners over other apps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the launcher see every installed app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <meta-data android:name="flavor" android:value="car" />

        <activity
            android:name="com.mk.homedash.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name="com.mk.homedash.PrayerAlert" android:exported="false" />
    </application>
</manifest>
